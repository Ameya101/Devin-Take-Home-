generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Kit models
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String
  /// viewer | support_agent | finance_approver | eng_admin | platform_admin
  role  String

  approvalRequests  ApprovalRequest[] @relation("requestedBy")
  approvalDecisions ApprovalRequest[] @relation("decidedBy")
  refunds           Refund[]
}

/// Append-only, hash-chained audit log. Never update or delete rows.
model AuditEvent {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  prevHash   String   @unique // two events can never claim the same predecessor, so the chain cannot fork
  hash       String   @unique

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorEmail])
  @@index([timestamp])
}

model ApprovalRequest {
  id            String    @id @default(cuid())
  type          String
  payload       Json
  /// pending | approved | rejected | executed | failed
  status        String    @default("pending")
  /// Urgent requests are listed first in approvers' queues. Set from the approval type.
  urgent        Boolean   @default(false)
  requestedById String
  requestedBy   User      @relation("requestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime  @default(now())
  decidedById   String?
  decidedBy     User?     @relation("decidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?

  @@index([status])
  @@index([status, urgent])
}

// ---------------------------------------------------------------------------
// Refunds app
// ---------------------------------------------------------------------------

model Customer {
  id       String    @id @default(cuid())
  name     String
  email    String    @unique
  payments Payment[]
}

model Payment {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  amountCents Int
  currency    String
  /// succeeded | partially_refunded | refunded | failed
  status      String
  cardLast4   String
  createdAt   DateTime @default(now())
  refunds     Refund[]

  @@index([customerId])
}

model Refund {
  id                String   @id @default(cuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id])
  amountCents       Int
  reason            String
  note              String?
  /// requested | pending_approval | processed | rejected
  status            String
  requestedById     String
  requestedBy       User     @relation(fields: [requestedById], references: [id])
  approvalRequestId String?  @unique
  providerRefundId  String?
  createdAt         DateTime @default(now())

  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Feature flags app
// ---------------------------------------------------------------------------

model FeatureFlag {
  id             String              @id @default(cuid())
  key            String              @unique
  description    String
  ownerTeam      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  environments   FlagEnvironment[]
  changeRequests FlagChangeRequest[]
}

/// Per-environment state of a flag. Rollout applies only while enabled.
model FlagEnvironment {
  id             String      @id @default(cuid())
  flagId         String
  flag           FeatureFlag @relation(fields: [flagId], references: [id])
  /// dev | staging | prod
  environment    String
  enabled        Boolean     @default(false)
  rolloutPercent Int         @default(0)
  updatedAt      DateTime    @updatedAt

  @@unique([flagId, environment])
}

/// Immutable record of a prod change request or kill switch. Its status is the linked ApprovalRequest's status.
model FlagChangeRequest {
  id                 String      @id @default(cuid())
  flagId             String
  flag               FeatureFlag @relation(fields: [flagId], references: [id])
  /// change | kill_switch
  kind               String
  /// prod
  environment        String
  fromEnabled        Boolean
  fromRolloutPercent Int
  toEnabled          Boolean
  toRolloutPercent   Int
  reason             String?
  requestedById      String
  approvalRequestId  String      @unique
  /// "<flagId>:<kind>" while the approval is pending, null once decided: at most one pending request per flag and kind.
  pendingSlot        String?     @unique
  createdAt          DateTime    @default(now())

  @@index([flagId])
}
