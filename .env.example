# --- Database -----------------------------------------------------------------
# Prisma connection string. SQLite for local dev; the path is relative to prisma/.
DATABASE_URL="file:./dev.db"

# --- Auth ---------------------------------------------------------------------
# Which AuthProvider the kit uses: "dev" (pick a seeded user on /login, DEV ONLY)
# or "oidc" (Entra ID / Okta, currently a stub; see src/kit/auth/oidc-provider.ts).
AUTH_PROVIDER="dev"

# The dev provider is refused when NODE_ENV=production (e.g. `npm run start`) unless this is "true".
# Only set it for a local production-mode demo; never in a deployed environment.
ALLOW_DEV_AUTH_IN_PRODUCTION="false"

# Password used to sign/encrypt the httpOnly session cookie (iron-session).
# Must be at least 32 characters. Generate one with: openssl rand -base64 32
# `npm install` writes a random one into a new .env; production refuses this example value.
SESSION_SECRET="dev-only-insecure-session-secret-change-me-0123456789"

# OIDC settings, only read when AUTH_PROVIDER="oidc" (stub, not wired up yet).
# Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
# Okta issuer:     https://<your-org>.okta.com/oauth2/default
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# --- Payments -----------------------------------------------------------------
# Which PaymentsAdapter the Refunds app uses. Only "mock" exists today.
PAYMENTS_ADAPTER="mock"

# Where the mock processor records issued refunds: append-only JSONL, outside the DB so reconciliation can
# find refunds whose DB transaction rolled back. Never rewritten or expired.
MOCK_PAYMENTS_LOG=".mock-payments.jsonl"
